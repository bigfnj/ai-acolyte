#!/usr/bin/env node
'use strict';

const fs = require('fs');
const path = require('path');
const os  = require('os');
// NOTE: `../src/permissions` is NOT required here. The names used by bypass()
// and the wildcarding pass are loaded only when those paths run. Nothing on the
// hook path needs the module once the fixed-point cache answers the common case,
// and the require is
// 3.5 ms of the ~13 ms that cache saves. A test asserts the module is absent
// from require.cache on a hit, because moving this back would halve the win with
// no functional symptom at all.
// Legacy cleanup, agent-guidance, agent-gates and child_process are used by
// individual command verbs and by nothing on the hook path, which runs after
// every
// single tool call. `learn()` below already lazy-requires the learner stack for
// this reason; the same reasoning was never extended to these. Measured at the
// process level: 50 ms for bare node, 58 ms with only what the hook needs,
// 70 ms with all of it, so this is ~12 ms returned per tool call.
//
// `policy-lock` and `local-settings` were the two the reasoning missed, and they
// were the ones it applied to most cleanly: BOTH are reachable only after the
// existsSync gate in finish(), the case the comment there documents as
// normal ("zero such files exist anywhere in the measured project tree"), and
// each drags a further module in — crypto behind policy-lock, policy-guard
// behind local-settings. Re-measured over 15 runs each: 50.1 ms bare node,
// 63.3 ms with permissions alone, 71.6 ms with all three. Another ~8 ms
// returned per tool call, for requires the common path never reaches. Node
// caches modules, so the verbs that do need them pay the load exactly once.

const SETTINGS  = path.join(os.homedir(), '.claude', 'settings.json');
const PACK_PATH = path.join(__dirname, '..', 'patterns', 'starter-pack.json');
const LEARN_USAGE = 'usage: wildcard-perms --learn scan|status|apply|undo|hits ' +
  '[--mode observe|recommend|auto-safe] [--workspace <path>] ' +
  '[--codex-scope user|off] [--threshold <count>] ' +
  '[--codex-executable <path>]\n';
// Codex workspace scope is WITHDRAWN. Three different trust notions were in
// play and none of them was the one that mattered: VS Code's
// `workspace.isTrusted` (which says the EDITOR may run code from this folder),
// this flag (which was unguarded and asked nothing), and Codex's own project
// trust (which is what actually decides whether Codex loads a workspace rule
// file at all). Writing an allow rule into a repository on the strength of the
// first two is a capability whose trust model could not be stated, so it was
// removed rather than certified. See docs/codex-certification.md.
//
// The flag VALUE stays parseable so an existing script reaches this message
// instead of silently landing in user scope and writing rules to a different
// file than it asked for.
const WORKSPACE_SCOPE_WITHDRAWN =
  'wildcard-perms --codex-scope workspace: withdrawn. Workspace-scoped Codex rules were ' +
  'removed because their trust model could not be stated: VS Code workspace trust, this ' +
  'flag and Codex\'s own project trust are three different decisions, and only the third ' +
  'governs whether Codex loads a workspace rule file. Nothing was changed. Use ' +
  '--codex-scope user, or --codex-scope off. To remove rules an older release already ' +
  'wrote into a repository, run: wildcard-perms --codex-workspace-rules remove ' +
  '[--workspace <path>]\n';
const WORKSPACE_RULES_USAGE =
  'usage: wildcard-perms --codex-workspace-rules status|remove [--workspace <path>]\n';
const DRAIN_USAGE = 'usage: wildcard-perms --drain [--workspace <path>] [--dry-run]\n';
const GUIDANCE_USAGE = 'usage: wildcard-perms --guidance on|off|status\n' +
  '       wildcard-perms --guidance derived\n' +
  '       wildcard-perms --guidance accept|decline|reset <id>\n';
const GATES_USAGE = 'usage: wildcard-perms --gates on|off|status|refresh\n';

// Every active verb, the two retired MAX flags, and the one-way cleanup for
// withdrawn Codex workspace rules. Keeping the retired flags in dispatch is a
// safety boundary: an old invocation must reach a read-only or cleanup handler,
// never fall through to hook mode and rewrite settings.json.
const VERBS = ['--learn', '--seed', '--drain', '--guidance', '--gates',
  '--codex-max', '--max', '--bypass', '--codex-workspace-rules'];
const HELP_USAGE = 'wildcard-perms — generalize approved Claude Code and Codex permissions\n\n' +
  'Run with NO arguments to act as a PostToolUse hook (reads a JSON event on stdin).\n\n' +
  LEARN_USAGE + DRAIN_USAGE + GUIDANCE_USAGE + GATES_USAGE +
  'usage: wildcard-perms --seed\n' +
  'usage: wildcard-perms --bypass on|off|status\n' +
  WORKSPACE_RULES_USAGE +
  'usage: wildcard-perms --help | --version\n';

const argv = process.argv.slice(2);
if (argv.includes('--help') || argv.includes('-h')) {
  // Before the verbs on purpose, so `--learn --help` explains rather than runs.
  process.stdout.write(HELP_USAGE);
} else if (argv.includes('--version') || argv.includes('-V')) {
  // Required lazily: the hook path must not pay for reading package.json.
  process.stdout.write(`${require('../package.json').version}\n`);
} else if (argv.length && !VERBS.some((verb) => argv.includes(verb))
    && argv.some((arg) => arg.startsWith('-'))) {
  // An unrecognized flag must NEVER reach hook mode. Hook mode rewrites
  // settings.json, so `--gate` (a typo for `--gates`) silently rewrote the
  // user's permission policy and exited 0 — and on a TTY, where nothing ever
  // closes stdin, it instead hung forever waiting for an event that was never
  // coming. There was also no `--help` at all, so the single most likely first
  // command anyone types was itself a policy write.
  process.stderr.write('wildcard-perms: unrecognized option '
    + `${argv.filter((arg) => arg.startsWith('-')).join(' ')}\n\n${HELP_USAGE}`);
  process.exitCode = 2;
} else if (argv.includes('--learn')) {
  learn(argv);
} else if (argv.includes('--seed')) {
  seed();
} else if (argv.includes('--drain')) {
  drain(argv);
} else if (argv.includes('--guidance')) {
  guidance(argv);
} else if (argv.includes('--gates')) {
  gates(argv);
} else if (argv.includes('--codex-max')) {
  legacyCodexMax(argv);
} else if (argv.includes('--max')) {
  legacyClaudeMax(argv);
} else if (argv.includes('--bypass')) {
  bypass(argv);
} else if (argv.includes('--codex-workspace-rules')) {
  codexWorkspaceRules(argv);
} else {
  // Hook mode. Claude Code sends a JSON context on stdin, and one field of it
  // matters: `cwd` names the project whose settings.local.json may have just
  // received the approval that fired this hook.
  //
  // A PostToolUse payload carries the tool's OUTPUT, so its size is whatever the
  // tool printed — a `git log` on a large repo, a build, a whole file read. This
  // accumulated it without a bound, on the one path that runs after every single
  // tool call, to read one short string out of it.
  //
  // The cap must never hand run() a TRUNCATED prefix, which is the trap this has
  // to be written around: a prefix is invalid JSON, hookCwd() returns null, the
  // project-local drain silently stops promoting approvals, and nothing in any
  // log says why. A hook that quietly does half its job forever is strictly worse
  // than one that says it did less. So overflow is EXPLICIT — stop accumulating,
  // drop what was collected rather than parse half of it, say so on stderr, and
  // pass null, which is the same "no cwd, no drain" route the payload-without-a-
  // cwd case already takes. The user-scope wildcarding pass does not read the
  // payload at all and still runs.
  //
  // Chunks keep being consumed after the cap so the writer is never left blocked
  // on a full pipe; they are simply not kept.
  //
  // Read SYNCHRONOUSLY, with fs.readSync on fd 0, rather than through
  // process.stdin. The stream was the single largest term left in a hook call:
  // constructing the stdin Socket, entering the event loop for the 'data'/'end'
  // round trip and tearing it back down costs 5.4 min / 5.1 p50 ms of a 59-65 ms
  // hook, measured cold in fresh interleaved processes against a purpose-built
  // arm with this change removed (n=41 x 3 runs: min -5.359/-6.382/-5.567,
  // p50 -3.815/-5.852/-5.677). It is NOT the wait for the data: repeating the
  // measurement with the payload written 20 ms after spawn gives the same
  // -4.810 min / -6.205 p50, so what is saved is the stream machinery itself.
  //
  // Deliberately a bounded loop rather than the one-liner `fs.readFileSync(0)`.
  // That reads the WHOLE payload into memory before anything can cap it, which
  // reinstates exactly the unbounded accumulation the cap above exists to
  // prevent — a PostToolUse payload carries the tool's output. This keeps both
  // properties: at most HOOK_STDIN_LIMIT bytes are ever RETAINED, and the pipe
  // is still drained to EOF so the writer is never left blocked.
  //
  // The loop must run to `read === 0`. A short read is not EOF — a pipe hands
  // over whatever has arrived — so stopping at the first one truncates a payload
  // delivered in pieces, and a truncated payload is invalid JSON, which is the
  // silent-drain-failure trap this whole section is written around. That is what
  // the chunked-delivery test pins.
  const HOOK_STDIN_LIMIT = 1024 * 1024;
  let input = '';
  let overflowed = false;
  {
    const buffer = Buffer.allocUnsafe(64 * 1024);
    const kept = [];
    let total = 0;
    for (;;) {
      let read;
      try { read = fs.readSync(0, buffer, 0, buffer.length, null); }
      catch (err) {
        // EAGAIN is a non-blocking pipe with nothing ready yet, which the stream
        // used to wait out for us. Yield the thread rather than spinning on it.
        // Anything else — EBADF from a closed stdin, EOF on the platforms that
        // raise it instead of returning 0 — ends the payload.
        if (err.code === 'EAGAIN') {
          Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 1);
          continue;
        }
        break;
      }
      if (read === 0) break;
      if (overflowed) continue;
      if (total + read > HOOK_STDIN_LIMIT) {
        overflowed = true;
        kept.length = 0;
        total = 0;
        continue;
      }
      // Copied out: `buffer` is reused by the next read.
      kept.push(Buffer.from(buffer.subarray(0, read)));
      total += read;
    }
    // Decoded once, from the joined bytes, so a multi-byte character split
    // across two reads survives.
    if (!overflowed) input = Buffer.concat(kept, total).toString('utf8');
  }
  if (overflowed) {
    // Said out loud on every occurrence. A control that runs degraded and does
    // not report it is indistinguishable from one that is working.
    process.stderr.write(
      `wildcard-perms: hook event exceeded ${HOOK_STDIN_LIMIT} bytes, so no cwd was `
      + 'read from it and the project-local drain was skipped for this call. The '
      + 'user-scope pass still ran.\n'
    );
  }
  run(overflowed ? null : input);
}

// The first positional argument after a verb, with flag/value pairs skipped, so
// a flag written before the id is not mistaken for the id.
function positionalAfter(args, name, skip) {
  const start = args.indexOf(name);
  if (start === -1) return undefined;
  for (let index = start + skip; index < args.length; index += 1) {
    if (String(args[index]).startsWith('--')) { index += 1; continue; }
    return args[index];
  }
  return undefined;
}

function learnOption(args, name, fallback) {
  const index = args.indexOf(name);
  if (index === -1) return fallback;
  const value = args[index + 1];
  if (!value || value.startsWith('--')) throw new Error(`${name} requires a value`);
  return value;
}

// "Has this partition ever been scanned?" — the one thing that separates a live
// workspace state from the stub a mode change leaves behind, since setMode()
// saves a state file the first time it runs whether or not anything has been
// observed. An unreadable or half-written file answers no, so a corrupt state
// can never capture the default.
function stateWasScanned(statePath) {
  try {
    return !!JSON.parse(fs.readFileSync(statePath, 'utf8').replace(/^\uFEFF/, '')).lastScanAt;
  } catch { return false; }
}

// The Auto Learn state file is partitioned by a hash of the workspace root, and
// the extension's root is the VS Code workspace FOLDER — which is almost never
// the directory a terminal happens to be sitting in. Defaulting to
// `process.cwd()` therefore keyed a different and usually absent file. Measured
// on the development box: the CLI read `auto-learn-state.397b082565ea6f56.json`,
// which did not exist, while the extension was writing
// `auto-learn-state.4a20f158639aa72c.json` with 613 candidates and 20000
// observation hashes in it. `--learn status` printed zeros, and "Auto Learn is
// doing nothing" is indistinguishable from "you are reading the wrong file".
//
// So walk UP from cwd and take the workspace that already owns a state file.
// Only ANCESTORS are candidates, and that is the whole safety argument: every
// one of them CONTAINS the cwd, so the state can never belong to a project this
// invocation is not inside. A scanned state beats an unscanned one even when the
// unscanned one is nearer, because opening a subdirectory in VS Code is enough
// to create a stub. With no state file anywhere above, cwd stands, so a first
// `--learn scan` in a fresh workspace still gets its own partition.
//
// The candidate path is asked of the MANAGER rather than recomputed here.
// Rehashing the name in this file is precisely how the two halves drifted apart
// the first time, and a second copy would drift again on the next rename.
function inferWorkspaceRoot(createAutoLearnManager) {
  const start = path.resolve(process.cwd());
  let owned = null;
  for (let dir = start; ;) {
    const statePath = createAutoLearnManager({ workspaceRoot: dir }).paths.state;
    if (fs.existsSync(statePath)) {
      if (!owned) owned = dir;
      if (stateWasScanned(statePath)) return dir;
    }
    const parent = path.dirname(dir);
    if (parent === dir) break;
    dir = parent;
  }
  return owned || start;
}

// One resolution shared by every verb that reads the learner's state, so
// `--learn` and `--guidance derived` can never disagree about which workspace
// they are in. An explicit `--workspace` is still absolute law: nothing is
// inferred over a value the user typed.
function workspaceRootFor(args, createAutoLearnManager) {
  const explicit = learnOption(args, '--workspace', null);
  return explicit === null
    ? inferWorkspaceRoot(createAutoLearnManager)
    : path.resolve(explicit);
}

function learn(args) {
  // Keep the PostToolUse hot path independent of the optional learner stack.
  const { createAutoLearnManager } = require('../src/auto-learn-manager');
  const index = args.indexOf('--learn');
  const action = String(args[index + 1] || 'status').toLowerCase();

  try {
    const modeValue = learnOption(args, '--mode', null);
    const mode = modeValue ? String(modeValue).toLowerCase() : null;
    if (mode && !['observe', 'recommend', 'auto-safe'].includes(mode)) {
      process.stderr.write(LEARN_USAGE);
      process.exitCode = 1;
      return;
    }
    const workspaceRoot = workspaceRootFor(args, createAutoLearnManager);
    const codexScope = String(learnOption(args, '--codex-scope', 'user')).toLowerCase();
    if (!['user', 'workspace', 'off'].includes(codexScope)) {
      process.stderr.write(LEARN_USAGE);
      process.exitCode = 1;
      return;
    }
    // WITHDRAWN, not removed from the parser. Same shape as the retired MAX
    // flags above: an existing invocation must reach a handler that refuses and
    // explains, never fall through to a different scope and write rules
    // somewhere the caller did not ask for.
    if (codexScope === 'workspace') {
      process.stderr.write(WORKSPACE_SCOPE_WITHDRAWN);
      process.exitCode = 1;
      return;
    }
    const thresholdValue = learnOption(args, '--threshold', null);
    const threshold = thresholdValue === null ? null : Number(thresholdValue);
    if (threshold !== null && (!Number.isInteger(threshold) || threshold < 1)) {
      throw new Error('--threshold must be a positive integer');
    }
    const codexRulesPath = codexScope === 'off' ? null
      : path.join(os.homedir(), '.codex', 'rules', 'permission-wildcarding.rules');
    const manager = createAutoLearnManager({
      workspaceRoot,
      codexRulesPath,
      codexExecutable: learnOption(args, '--codex-executable', 'codex'),
      mode: mode || 'recommend',
      threshold: threshold || 3,
    });
    if (mode || threshold !== null) {
      const current = manager.status();
      manager.setMode(mode || current.mode, threshold === null ? undefined : threshold);
    }

    let result;
    if (action === 'scan') result = manager.scan();
    else if (action === 'status') result = manager.status();
    else if (action === 'apply') result = manager.apply({ includeReviewed: false });
    else if (action === 'undo') result = manager.undo();
    else if (action === 'hits') result = manager.rebuildManagedHits();
    else {
      process.stderr.write(LEARN_USAGE);
      process.exitCode = 1;
      return;
    }
    process.stdout.write(JSON.stringify(result, null, 2) + '\n');
  } catch (error) {
    process.stderr.write(`wildcard-perms --learn ${action}: ${error.message}\n`);
    process.exitCode = 1;
  }
}

function readSettings() {
  try {
    return JSON.parse(fs.readFileSync(SETTINGS, 'utf8'));
  } catch (err) {
    // ENOENT is normal. A SyntaxError is the zero-byte or half-written window of
    // somebody else's atomic write — routine rather than exotic, because Claude
    // Code rewrites this file in place on every /model, /effort and approval —
    // and it used to print, because a SyntaxError has no `.code` and so failed
    // the ENOENT test. That broke the hook path's "quiet by design" contract on
    // exactly the interleaving this whole change is about. Anything else is
    // genuinely unexpected and still worth saying out loud.
    if (err.code !== 'ENOENT' && !(err instanceof SyntaxError)) {
      process.stderr.write(`wildcard-perms: read error: ${err.message}\n`);
    }
    return null;
  }
}

// The shared rebasing writer, required lazily so the hook path pays for it only
// when it has actually decided to write. No backup hook: the extension owns the
// high-water mark, and giving the CLI one here would be a behaviour change
// smuggled in beside a correctness fix.
function settingsWriter() {
  const { createSettingsWriter } = require('../src/settings-write');
  return createSettingsWriter({ settingsPath: SETTINGS });
}

// readSettings() collapses "absent" and "unreadable" into null, which is right
// for a reader and destructive for a WRITER: `readSettings() ?? {}` followed by
// a whole-object write replaces the user's settings.json with just the key the
// verb happened to touch. A removed whole-object writer demonstrated the failure
// at its worst by replacing the file with only blanket grants and a hook. The
// remaining bypass writer and the one-way legacy cleanup both refuse instead.
//
// This is the "exists but could not be parsed" refusal src/settings-write.js:150-162
// documents, reached from verbs that do not go through writeAllow.
function readSettingsForWrite(label) {
  const { readSettingsState, SETTINGS_UNREADABLE } = require('../src/settings-write');
  const state = readSettingsState(SETTINGS);
  if (state.state === SETTINGS_UNREADABLE) {
    process.stderr.write(
      `wildcard-perms ${label}: refused — ${SETTINGS} exists but could not be read or parsed.\n`
      + '  Nothing was changed. That is usually a file being written right now;\n'
      + '  retry in a moment, or fix the file if it is genuinely damaged.\n'
    );
    return null;
  }
  // Absent yields {}, which is the legitimate first-run case.
  return state.settings;
}

// writeSettings is GONE. It was a naive whole-object writer — read, compute,
// spread the snapshot back. The remaining whole-object transforms go through
// settingsWriter().writeTransform, which
// re-reads, runs the transform against that read, and compare-and-swaps on the
// bytes. Deleting the primitive matters as much as fixing the callers: it was
// the thing the next verb author would have found and reused.

function run(input) {
  // Read the bytes ONCE, as a Buffer. The hit path never pays the utf8 decode of
  // a string it would throw away, and on a miss JSON.parse takes the Buffer
  // directly.
  let bytes;
  try { bytes = fs.readFileSync(SETTINGS); }
  catch { return finish(input, false); }   // absent, or unreadable — both silent

  // The cache answers exactly one question: are THESE bytes already known to be
  // a fixed point of processAllowList? A hit skips the parse, the pass, and the
  // whole `../src/permissions` require chain.
  //
  // What that is worth, re-measured cold against a purpose-built no-cache variant
  // rather than against this code's own forced-miss path: 8.93 min / 9.23 p50 ms
  // of process wall. The earlier "13.2 ms against ~1 ms to key the file" was an
  // in-process sum whose total happened to be right while both of its terms were
  // wrong (require 3.43 not 4.8, pass 9.96 not 8.1), and "~1 ms" omitted this
  // cache module's own require, which is 1.97 ms of a 3.19 ms consult.
  //
  // Its own module pulls nothing but fs/path/os, which is why the hash is
  // hand-rolled: `require('crypto')` plus the first createHash plus a digest is
  // 4.15 ms cold in a fresh process (min 3.758 over 21 runs), because the lazy
  // OpenSSL init survives the module snapshot.
  //
  // A hit must still reach finish(). The drain's existsSync gate is independent
  // of the wildcarding fixed point, and skipping it would silently stop
  // promoting project-local approvals.
  const cache = require('../src/fixed-point-cache');
  if (cache.isFixedPoint(bytes)) return finish(input, false);

  // Miss. Only now is the generalizer loaded — that require is 3.5 ms and the
  // cache is the only thing that makes deferring it possible, since the pass was
  // previously unconditional. See the lazy-require discipline at the top of this
  // file.
  const { processAllowList } = require('../src/permissions');

  let settings;
  try { settings = JSON.parse(bytes); }
  catch { return finish(input, false); }   // mid-write; the next run retries
  if (!settings || typeof settings !== 'object') return finish(input, false);

  const before = settings?.permissions?.allow ?? [];
  const after  = processAllowList(before);

  // This read is a NEGATIVE TEST ONLY, which is what makes it safe unlocked. If
  // the list is already a fixed point — the overwhelmingly common case, measured
  // at 404 of 423 entries already generalized here — we exit having written
  // nothing, so a stale read costs nothing. The moment it differs, everything
  // authoritative is redone inside the lock.
  //
  // Deliberately NOT "lock on every call": the lock cycle is 3.7 ms of file
  // operations, and paying it on every tool call to discover there is nothing to
  // do is the same mistake the drain's existsSync test already corrected.
  const pending = JSON.stringify(before) !== JSON.stringify(after);

  // Record the key ONLY for a verified fixed point, and only for the bytes we
  // actually read and checked. Never for bytes we believe we wrote: writeAllow
  // re-reads and rebases inside itself, returns counts rather than the written
  // text, and can fall back to a non-atomic in-place write — so the post-write
  // content is a file state this process never saw. One wasted miss after a
  // write is the correct price, and the cache converges on the next call because
  // what writeAllow leaves behind is itself a fixed point (verified: 0 of 400
  // permutations of the live list are not).
  if (!pending) cache.writeFixedPoint(cache.fixedPointKey(bytes));

  return finish(input, pending);
}

// One exit path for the hook, and now ONE lock acquisition covering both jobs.
//
// The drain runs whether or not the user-scope pass changed anything: Claude
// Code persists an "always approve" into the project's settings.local.json, and
// the hook fires immediately after that write, so this is the moment to promote
// it.
//
// The two jobs used to lock separately — the wildcarding write took no lock at
// all and the drain took its own — leaving a window between them for Auto Learn
// to land its settings write and its claims write. That is verbatim the
// "interleaved write" src/policy-lock.js:3-7 exists to prevent, so they now share
// one acquisition. A busy lock stays silent: the next tool call fires the hook
// again and the pass is idempotent, so losing a turn costs at most one extra
// prompt and never a permission.
// Every caller now `return`s into this rather than relying on it never returning.
// run() went from one tail call to five (read threw, cache hit, parse threw, not
// an object, and the computed pending flag); leaning on process.exit alone across
// five branches is how a cache write ends up running after a finish that did not
// exit.
function finish(input, wildcardPending) {
  const cwd = hookCwd(input);
  const drainPending = !!cwd
    && fs.existsSync(path.join(cwd, '.claude', 'settings.local.json'));
  if (!wildcardPending && !drainPending) process.exit(0);

  const { createPolicyLock, POLICY_LOCK_PATH } = require('../src/policy-lock');
  try {
    createPolicyLock({ lockPath: POLICY_LOCK_PATH }).locked(() => {
      if (wildcardPending) wildcardUnderLock();
      if (drainPending) drainUnderLock(cwd);
    });
  } catch { /* busy, or an unreadable project — the next hook run retries */ }
  process.exit(0);
}

// The hook's event arrives as JSON on stdin; one field matters.
//
// The catch is NOT silent, and that is the whole point of it. Every way the
// payload can be damaged — a truncated read, a non-JSON event, a writer that
// died mid-message — lands here as a parse failure, returns null, and the
// project-local drain is skipped. Skipped silently, it stays skipped forever
// with nothing in any log to say why, which is the same failure the byte cap
// above is written around and is reported the same way. An EMPTY payload is
// different and stays quiet: no stdin at all is how every non-hook invocation
// and every test that supplies nothing arrives here, and it is not a fault.
function hookCwd(input) {
  const text = String(input || '');
  if (!text.trim()) return null;
  let event;
  try { event = JSON.parse(text); }
  catch {
    process.stderr.write(
      `wildcard-perms: the ${text.length}-byte hook event on stdin did not parse as JSON, `
      + 'so no cwd was read from it and the project-local drain was skipped for this call. '
      + 'The user-scope pass still ran.\n'
    );
    return null;
  }
  const cwd = event?.cwd;
  return typeof cwd === 'string' && cwd ? cwd : null;
}

// The authoritative half of the pass: the caller's snapshot is DISCARDED and
// everything recomputed from a read taken inside the lock.
//
// Replaying the earlier delta would be unsound because settings can change after
// the unlocked pass. Recomputing costs the warm 57 ms, and only on the rare
// changed path.
//
// Because `fresh` is what writeAllow re-reads, its rebase degenerates to
// identity here, and what it contributes is the rest of its contract: deny is
// additive only, and every unrelated top-level field — model, effortLevel, env,
// hooks — comes from the newest file instead of a stale spread. Those fields,
// not deny, are the common casualty: Claude Code rewrites them constantly.
function wildcardUnderLock() {
  const { processAllowList } = require('../src/permissions');
  const writer = settingsWriter();
  const state = writer.readSettingsState();
  const fresh = state.settings;
  if (!fresh) return; // absent or mid-write; the next hook run retries

  const before = Array.isArray(fresh?.permissions?.allow) ? fresh.permissions.allow : [];
  const after = processAllowList(before);
  if (JSON.stringify(before) === JSON.stringify(after)) return; // someone got there first

  try {
    // Reported from what the WRITER returns, never from this function's own
    // snapshot. writeAllow re-reads and rebases inside itself, so its counts are
    // measured against the file the write actually landed on; `before`/`after`
    // here are what this pass intended against a read taken earlier. They agree
    // in the common case and diverge exactly when a concurrent Claude Code write
    // lands in between — the case a diagnostic exists to describe. The anti-
    // pattern is spelled out at src/settings-write.js:212-214, where it produced
    // "+299 restored" over a file that already had them.
    const written = writer.writeAllow(fresh, after);
    process.stderr.write(
      `wildcard-perms: +${written.addedAllow} -${written.removedAllow} → `
      + `${written.allow.length} entries\n`
    );
  } catch (err) {
    // SETTINGS_UNREADABLE is "come back in a moment", not a failure to shout
    // about — and the hook path is quiet by design either way.
    if (err?.code !== 'SETTINGS_UNREADABLE') {
      process.stderr.write(`wildcard-perms: write error: ${err.message}\n`);
    }
  }
}

function drainUnderLock(cwd) {
  const report = drainWorkspace(cwd);
  if (!report.changed) return;
  process.stderr.write(
    `wildcard-perms: local drain — promoted ${report.promoted.length}, ` +
    `pruned ${report.pruned.length}, kept ${report.kept}\n`
  );
}

// Merge entries into the user-scope allow list, generalizing and pruning the
// result exactly as the hook pass would, so a promoted permission is
// indistinguishable from one approved directly.
function mergeUserAllow(entries) {
  // Through the rebasing writer, and computed from ITS read, so the rebase
  // degenerates to identity. This was the third unrebased read-modify-write in
  // this file, and the one that ran on the hook path immediately after the
  // wildcarding write — so it could revert what the extension had just landed.
  // The extension's half of the drain already routed through writeAllow
  // (vscode-extension/extension.js applyUserAllow); the CLI's was left behind.
  const { processAllowList } = require('../src/permissions');
  const writer = settingsWriter();
  const fresh = writer.readSettingsState().settings ?? {};
  const existing = Array.isArray(fresh?.permissions?.allow) ? fresh.permissions.allow : [];
  const merged = processAllowList([...new Set([...existing, ...entries])]);
  writer.writeAllow(fresh, merged);
}

function drainWorkspace(workspaceRoot, { dryRun = false } = {}) {
  const { drainLocalSettings } = require('../src/local-settings');
  return drainLocalSettings({
    workspaceRoot,
    readUserSettings: readSettings,
    applyUserAllow: mergeUserAllow,
    dryRun,
  });
}

// drainFromHook is gone: its body is now drainUnderLock(), called from finish()
// inside the SAME lock acquisition as the wildcarding write. Keeping its own
// lock meant two acquisitions per changed hook run with a window between them,
// which is exactly what the shared lock is for. The cheap existsSync test it
// introduced survives, in finish().

// Promote a project's local approvals into user scope and drop the ones user
// scope now covers. `--dry-run` reports without writing either file.
function drain(args) {
  let workspaceRoot;
  try {
    workspaceRoot = path.resolve(learnOption(args, '--workspace', process.cwd()));
  } catch (err) {
    process.stderr.write(`wildcard-perms --drain: ${err.message}\n${DRAIN_USAGE}`);
    process.exit(1);
  }
  const dryRun = args.includes('--dry-run');

  withPolicyLock('--drain', () => {
    const report = drainWorkspace(workspaceRoot, { dryRun });

    if (report.error) {
      process.stderr.write(`wildcard-perms --drain: ${report.path}: ${report.error}\n`);
      process.exitCode = 1;
      return;
    }
    if (report.blocked === 'legacy-blanket') {
      process.stderr.write(
        'wildcard-perms --drain: legacy MAX configuration is still active and its blanket ' +
        'grants cover every local entry. Run wildcard-perms --max off to remove it first.\n'
      );
      process.exitCode = 1;
      return;
    }
    if (!report.exists) {
      process.stdout.write(`wildcard-perms --drain: no project-local approvals at ${report.path}\n`);
      return;
    }
    if (!report.changed) {
      process.stdout.write(
        `wildcard-perms --drain: nothing to do — ${report.kept} local ` +
        `${report.kept === 1 ? 'entry is' : 'entries are'} project-specific\n`
      );
      return;
    }

    const promoted = dryRun ? report.promote : report.promoted;
    const pruned = dryRun ? report.prune : report.pruned;
    process.stdout.write(
      `wildcard-perms --drain${dryRun ? ' (dry run)' : ''}: ` +
      `${dryRun ? 'would promote' : 'promoted'} ${promoted.length} to user scope, ` +
      `${dryRun ? 'would prune' : 'pruned'} ${pruned.length} local ` +
      `${pruned.length === 1 ? 'entry' : 'entries'}, kept ${report.kept}\n`
    );
    if (promoted.length) process.stdout.write(promoted.map((p) => `  + ${p}`).join('\n') + '\n');
    if (!dryRun && !report.verified) {
      process.stderr.write(
        '  note: not every promotion is present in settings.json — managed policy may be ' +
        'filtering it. Nothing was pruned on its account.\n'
      );
    }
    for (const { candidate, rule } of report.denied) {
      process.stdout.write(`  ! ${candidate} not promoted — your deny rule ${rule} outranks it\n`);
    }
    if (report.backup) process.stdout.write(`  snapshot: ${report.backup}\n`);
  });
}

// Install (or remove) the managed shell-style block in ~/.claude/CLAUDE.md. The
// wildcarder can only generalize an approval that names one command, so this is
// the half of the job that has to happen in the agent's instructions.
function guidance(args) {
  const { guidanceStatusAll, setGuidanceAll } = require('../src/agent-guidance');
  const cmd = (args[args.indexOf('--guidance') + 1] || 'status').toLowerCase();

  if (cmd === 'status') {
    const states = guidanceStatusAll();
    if (!states.length) {
      process.stdout.write('wildcard-perms guidance: no agent instruction file found\n');
      return;
    }
    for (const state of states) {
      process.stdout.write(
        `wildcard-perms guidance [${state.agent}]: ${state.on ? 'ON' : 'OFF'}` +
        `${state.on && !state.current ? ' (older wording — run --guidance on to refresh)' : ''} ` +
        `(${state.readable ? state.path : `unreadable: ${state.path}`})\n`
      );
    }
    return;
  }

  // The derived half. Kept behind its own verbs because it is a different kind
  // of thing: `on`/`off` install a fixed paragraph, while these three install
  // advice earned from measured evidence, one item at a time, and nothing is
  // written until a human names the item.
  if (cmd === 'derived' || cmd === 'accept' || cmd === 'decline' || cmd === 'reset') {
    const { createAutoLearnManager } = require('../src/auto-learn-manager');
    try {
      // `--workspace` is not cosmetic here: the learner's state is partitioned
      // per workspace, so reading the wrong one reports an empty review on a
      // machine that has plenty to show. Same resolution as `--learn`, which is
      // the point — these two verbs used to default differently from each other
      // only by accident of having the same wrong line copied into both.
      const manager = createAutoLearnManager({
        workspaceRoot: workspaceRootFor(args, createAutoLearnManager),
      });
      if (cmd === 'derived') {
        process.stdout.write(JSON.stringify(manager.derivedReview(), null, 2) + '\n');
        return;
      }
      // Positionally, but skipping flag/value pairs. Taking `+ 2` blindly meant
      // `--guidance accept --workspace D:\x batch-file-edits` recorded a
      // decision for the id `--workspace`, which passes the id pattern, and
      // then ran a full reconcile against it.
      const id = positionalAfter(args, '--guidance', 2);
      if (!id) {
        process.stderr.write(`wildcard-perms --guidance ${cmd}: an id is required. ` +
          'Run --guidance derived to list them.\n');
        process.exit(1);
      }
      const outcome = manager.decideDerived(id, cmd);
      process.stdout.write(JSON.stringify(outcome, null, 2) + '\n');
      // A failed write to someone's instruction file must not exit 0. The
      // on/off path below already checks this; these verbs did not.
      const failed = (outcome.targets || []).filter((target) => target.error);
      if (failed.length) {
        for (const target of failed) {
          process.stderr.write(`wildcard-perms --guidance ${cmd} [${target.agent}]: ${target.error}\n`);
        }
        process.exitCode = 1;
      } else if (outcome.blocked) {
        process.stderr.write(`wildcard-perms --guidance ${cmd}: decision recorded, but the ` +
          `instruction file was left alone (${outcome.blocked}).\n`);
        process.exitCode = 1;
      }
    } catch (error) {
      process.stderr.write(`wildcard-perms --guidance ${cmd}: ${error.message}\n`);
      process.exitCode = 1;
    }
    return;
  }

  if (cmd !== 'on' && cmd !== 'off') {
    process.stderr.write(GUIDANCE_USAGE);
    process.exit(1);
  }

  const results = setGuidanceAll(cmd === 'on');
  if (!results.length) {
    process.stderr.write('wildcard-perms --guidance: no agent instruction file to write\n');
    process.exit(1);
  }
  for (const result of results) {
    if (result.error) {
      process.stderr.write(`wildcard-perms --guidance [${result.agent}]: ${result.error}\n`);
      process.exitCode = 1;
      continue;
    }
    process.stdout.write(
      `wildcard-perms guidance [${result.agent}]: ${cmd.toUpperCase()}` +
      `${result.changed ? '' : ' (already)'} — ${result.path}\n`
    );
  }
  if (cmd === 'on' && results.some((result) => result.changed)) {
    process.stdout.write('  loaded in every session of every project from the next session on.\n');
  }

  // `off` has to leave nothing of ours behind, and the shell-style block was not
  // the only thing this tool writes into an instruction file. An ACCEPTED derived
  // mitigation installs its own marker-fenced block, and no verb swept those:
  // `--guidance decline <id>` removes one at a time and only while the learner
  // still derives that id, while install.sh, install.ps1 and both uninstallers do
  // not touch instruction files at all. So an accepted block outlived the
  // uninstall of the tool that wrote it, with no command anywhere that removed it.
  //
  // Reconciling against an empty wanted-set is the removal path `decline` already
  // uses; removal reads only the markers, so a block this version no longer knows
  // how to derive still comes out.
  //
  // The learner's accepted/declined RECORD is deliberately left alone. Nothing
  // re-installs a block on its own — setDerivedGuidance has exactly one caller,
  // decideDerived — so the record is inert until a human decides again, and
  // erasing someone's decisions is not what "off" was asked to do.
  if (cmd === 'off') {
    const { setDerivedGuidance } = require('../src/derived-guidance');
    // No options, and that is now correct rather than an omission. The default
    // `backupDir` is the learner's `~/.claude/wildcarding/backups`, which is
    // where `decideDerived` puts the same `.pre-derived` copy — see the note on
    // setDerivedGuidance for why the two used to disagree and what it cost.
    for (const target of setDerivedGuidance([], [])) {
      if (target.error) {
        process.stderr.write(
          `wildcard-perms --guidance off [${target.agent}]: derived blocks were left in `
          + `place — ${target.error}\n`
        );
        process.exitCode = 1;
        continue;
      }
      if (!target.removed.length) continue;
      process.stdout.write(
        `wildcard-perms guidance [${target.agent}]: removed `
        + `${target.removed.length} derived `
        + `${target.removed.length === 1 ? 'block' : 'blocks'} `
        + `(${target.removed.join(', ')}) — ${target.path}\n`
      );
    }
  }
}

// The compiled memory gates. Same install plumbing as --guidance, separate markers and
// separate switch: one is this repo's wording, the other is whatever recall.py last
// compiled out of the memory corpus, so neither may turn the other off.
function gates(args) {
  const { spawnSync } = require('child_process');
  const { gatesStatusAll, setGatesAll } = require('../src/agent-gates');
  const cmd = (args[args.indexOf('--gates') + 1] || 'status').toLowerCase();

  if (cmd === 'status') {
    const states = gatesStatusAll();
    if (!states.length) {
      process.stdout.write('wildcard-perms gates: no agent instruction file found\n');
      return;
    }
    for (const state of states) {
      process.stdout.write(
        `wildcard-perms gates [${state.agent}]: ${state.on ? 'ON' : 'OFF'}` +
        `${state.on && !state.current ? ' (corpus changed — run --gates on to refresh)' : ''}` +
        `${state.compiled ? '' : ' (nothing compiled)'} ` +
        `(${state.readable ? state.path : `unreadable: ${state.path}`})\n`
      );
    }
    return;
  }

  // `refresh` = compile then install, which is what a SessionStart hook wants: edit a gate
  // in a memory file and the next session is correct with no remembered step. recall.py
  // re-execs itself into the toolbox venv, so a bare `python` is enough here.
  if (cmd === 'refresh') {
    const recall = path.join(__dirname, '..', 'memory', 'recall.py');
    const compile = spawnSync(process.env.TOOLBOX_PYTHON || 'python', [recall, '--gates-compile'],
      { encoding: 'utf8' });
    if (compile.error || compile.status !== 0) {
      // Non-fatal by design: a hook that fails loudly on every session start is worse than
      // a slightly stale block, and --gates status still reports the staleness.
      process.stderr.write('wildcard-perms --gates refresh: compile failed, '
        + `installing whatever was last compiled (${compile.error?.message
          || (compile.stderr || '').trim() || `exit ${compile.status}`})\n`);
    }
  }

  if (cmd !== 'on' && cmd !== 'off' && cmd !== 'refresh') {
    process.stderr.write(GATES_USAGE);
    process.exit(1);
  }

  const results = setGatesAll(cmd !== 'off');
  if (!results.length) {
    process.stderr.write('wildcard-perms --gates: no agent instruction file to write\n');
    process.exit(1);
  }
  for (const result of results) {
    if (result.error) {
      process.stderr.write(`wildcard-perms --gates [${result.agent}]: ${result.error}\n`);
      process.exitCode = 1;
      continue;
    }
    // `refresh` is the SessionStart hook, and a hook's stdout can be folded into the
    // session's context. Stay silent when nothing changed, so the common case costs no
    // tokens and a line appearing actually means something moved.
    if (cmd === 'refresh' && !result.changed) continue;
    process.stdout.write(
      `wildcard-perms gates [${result.agent}]: ${cmd.toUpperCase()}` +
      `${result.changed ? '' : ' (already)'} — ${result.path}\n`
    );
  }
  if (cmd !== 'off' && results.some((result) => result.changed)) {
    process.stdout.write('  standing orders resident from the next session on.'
      + (cmd === 'on' ? ' Re-run after editing a gate in a memory file.\n' : '\n'));
  }
}

function seed() {
  let pack;
  try {
    pack = JSON.parse(fs.readFileSync(PACK_PATH, 'utf8'));
  } catch (err) {
    process.stderr.write(`wildcard-perms --seed: cannot read starter pack: ${err.message}\n`);
    process.exit(1);
  }

  // Read, merge and write all INSIDE the lock, through the rebasing writer.
  // --seed had the same shape as the old hook path — read, merge, spread, write
  // — so it reverted whatever landed in between, and it took no lock at all
  // while `withPolicyLock` sat twenty lines below serving the other policy writers.
  //
  // Reporting happens after the lock is released, and nothing inside it calls
  // process.exit: an exit skips the release, and while recoverLock() reclaims a
  // dead owner's lock eventually, leaving one behind makes every other writer
  // wait for the staleness window first.
  let outcome = null;
  withPolicyLock('--seed', () => {
    const { processAllowList } = require('../src/permissions');
    const writer = settingsWriter();
    const settings = writer.readSettingsState().settings ?? {};
    const existing = Array.isArray(settings?.permissions?.allow) ? settings.permissions.allow : [];

    // Merge: existing entries first (preserve ordering), then new pack entries
    const merged = [...new Set([...existing, ...pack])];
    const after  = processAllowList(merged);

    if (JSON.stringify(existing) === JSON.stringify(after)) {
      outcome = { noop: true };
      return;
    }
    writer.writeAllow(settings, after);
    outcome = {
      after,
      added: after.filter(p => !existing.includes(p)),
      removed: existing.filter(p => !after.includes(p)),
    };
  });

  if (!outcome) return; // withPolicyLock already reported and exited
  if (outcome.noop) {
    process.stdout.write('wildcard-perms --seed: allow list already covers starter pack — nothing to do\n');
    return;
  }
  process.stdout.write(
    `wildcard-perms --seed: merged ${pack.length} starter entries — ` +
    `+${outcome.added.length} added, ${outcome.removed.length} pruned → ${outcome.after.length} total\n`
  );
  if (outcome.added.length) {
    process.stdout.write(outcome.added.map(p => `  + ${p}`).join('\n') + '\n');
  }
}

// Every Claude policy writer shares one lock, so one cannot land between Auto
// Learn's settings write and its claims write. Reads and writes both go inside.
function withPolicyLock(flag, run) {
  const {
    createPolicyLock, POLICY_LOCK_PATH, POLICY_LOCK_CODE, POLICY_LOCK_BUSY_MESSAGE,
  } = require('../src/policy-lock');
  try {
    createPolicyLock({ lockPath: POLICY_LOCK_PATH }).locked(run);
  } catch (err) {
    process.stderr.write(err?.code === POLICY_LOCK_CODE
      ? `wildcard-perms ${flag}: ${POLICY_LOCK_BUSY_MESSAGE}\n`
      : `wildcard-perms ${flag}: write error: ${err.message}\n`);
    process.exit(1);
  }
}

// Flip Claude Code's bypassPermissions mode on/off (our "skip every prompt"
// switch). `--bypass on|off|status`; bare `--bypass` reports status. Turning on
// stashes the previous mode so `off` restores it. Deny rules + Claude Code's
// hard circuit breakers still apply — this suppresses prompts, not safeguards.
function bypass(args) {
  const { applyBypass, isBypassOn, currentMode } = require('../src/permissions');
  const cmd = (args[args.indexOf('--bypass') + 1] || 'status').toLowerCase();

  if (cmd === 'status') {
    const settings = readSettings() ?? {};
    process.stdout.write(
      `wildcard-perms bypass: ${isBypassOn(settings) ? 'ON' : 'OFF'} (defaultMode=${currentMode(settings)})\n`
    );
    return;
  }

  if (cmd !== 'on' && cmd !== 'off') {
    process.stderr.write('usage: wildcard-perms --bypass on|off|status\n');
    process.exit(1);
  }

  withPolicyLock('--bypass', () => {
    // Kept ahead of the writer even though writeTransform refuses an unreadable
    // file too: this path owns the word "refused", which test/cli-hook.test.js
    // pins, while the writer's throw would surface as "write error:" through
    // withPolicyLock's catch.
    if (readSettingsForWrite('--bypass') === null) { process.exitCode = 1; return; }
    let res;
    try {
      // The transform runs against the writer's OWN fresh read, so
      // permissions.defaultMode is set on the newest file rather than on a
      // snapshot taken before the lock work. applyBypass touches nothing else.
      ({ result: res } = settingsWriter().writeTransform((latest) => applyBypass(latest, cmd === 'on')));
    } catch (err) {
      // Contention is transient and nothing was written, so say so rather
      // than reporting a refusal the user might act on. This code had no
      // reader anywhere until now.
      //
      // Required HERE, not at module scope: this file loads nothing from src/ on
      // the hook's common path. A catch body is the safest possible place for it
      // — it runs only on an error, and by then settingsWriter() has already
      // pulled the module in, so this is a require.cache hit.
      const { SETTINGS_CONTENDED_CODE } = require('../src/settings-write');
      process.stderr.write(err?.code === SETTINGS_CONTENDED_CODE
        ? `wildcard-perms --bypass: settings.json is being written by another `
          + `process — nothing was changed, try again in a moment.\n`
        : `wildcard-perms --bypass: refused — ${err.message}\n`);
      process.exitCode = 1;
      return;
    }
    if (!res.changed) {
      process.stdout.write(`wildcard-perms bypass: already ${cmd.toUpperCase()} (defaultMode=${res.to})\n`);
      return;
    }
    process.stdout.write(
      `wildcard-perms bypass: ${res.from} → ${res.to} — ` +
      `${cmd === 'on' ? 'ALL PROMPTS BYPASSED' : 'prompts restored'}. ` +
      `Reload the Claude Code window (or wait for context rollover) to apply.\n`
    );
    if (cmd === 'on') {
      process.stdout.write('  deny rules and hard circuit breakers still apply.\n');
    }
  });
}

// One-way cleanup for the withdrawn Codex WORKSPACE scope. Inspect or remove the
// rules file an older release wrote into a repository; there is deliberately no
// path that writes one.
//
// Ownership is proved by this tool's own marker pair and by nothing else. A
// `.codex/rules/permission-wildcarding.rules` with no markers is somebody's hand
// written file that happens to share the name, and it is left byte-for-byte
// alone — the same rule, for the same reason, as the retired MAX cleanup below.
function codexWorkspaceRules(args) {
  const { removeGeneratedCodexRules } = require('../src/policy-exporters');
  const cmd = String(args[args.indexOf('--codex-workspace-rules') + 1] || 'status').toLowerCase();
  if (cmd !== 'status' && cmd !== 'remove') {
    process.stderr.write(WORKSPACE_RULES_USAGE);
    process.exitCode = 1;
    return;
  }
  const root = path.resolve(learnOption(args, '--workspace', process.cwd()));
  const target = path.join(root, '.codex', 'rules', 'permission-wildcarding.rules');

  let text = null;
  try { text = fs.readFileSync(target, 'utf8'); }
  catch (err) {
    if (err?.code !== 'ENOENT') {
      process.stderr.write(`wildcard-perms --codex-workspace-rules: read error: ${err.message}\n`);
      process.exitCode = 1;
      return;
    }
  }

  if (text === null) {
    process.stdout.write(
      `wildcard-perms --codex-workspace-rules ${cmd}: no workspace Codex rules at ${target}. ` +
      'Workspace scope is withdrawn; nothing to clean up.\n'
    );
    return;
  }

  const result = removeGeneratedCodexRules(text);
  if (cmd === 'status') {
    process.stdout.write(
      `wildcard-perms --codex-workspace-rules status: ${target} exists, ` +
      `${result.changed ? 'and carries a generated block this tool can remove'
        : `and this tool will NOT touch it (${result.reason})`}.\n`
    );
    return;
  }

  if (!result.changed) {
    process.stderr.write(
      `wildcard-perms --codex-workspace-rules remove: refused — ${result.reason}. ` +
      `${target} is unchanged. Only a block between this tool's own markers is removable.\n`
    );
    process.exitCode = 1;
    return;
  }

  try {
    // Read again before writing so an edit that landed since the read is not
    // overwritten by a cleanup path.
    const current = fs.readFileSync(target, 'utf8');
    if (current !== text) {
      process.stderr.write(
        'wildcard-perms --codex-workspace-rules remove: the file changed during cleanup; ' +
        'nothing was written.\n'
      );
      process.exitCode = 1;
      return;
    }
    if (result.empty) {
      fs.unlinkSync(target);
      process.stdout.write(
        `wildcard-perms --codex-workspace-rules remove: removed ${target} — it held nothing ` +
        'but this tool\'s generated block. Restart Codex to apply.\n'
      );
      return;
    }
    const { writeFileAtomicSync } = require('../src/permissions');
    writeFileAtomicSync(target, result.text);
    const verified = fs.readFileSync(target, 'utf8');
    if (removeGeneratedCodexRules(verified).changed) {
      process.stderr.write(
        'wildcard-perms --codex-workspace-rules remove: the generated block is still present ' +
        'after the write. Nothing further was attempted.\n'
      );
      process.exitCode = 1;
      return;
    }
    process.stdout.write(
      `wildcard-perms --codex-workspace-rules remove: removed the generated block from ${target} ` +
      'and kept the rest of the file. Restart Codex to apply.\n'
    );
  } catch (err) {
    process.stderr.write(`wildcard-perms --codex-workspace-rules remove: write error: ${err.message}\n`);
    process.exitCode = 1;
  }
}

// Hidden compatibility handler for the retired Codex MAX flag. It can inspect
// or remove state written by old releases. There is deliberately no enable path.
function legacyCodexMax(args) {
  const {
    CODEX_CONFIG, LEGACY_CODEX_STATE_FILE, legacyCodexMaxStatus,
    removeLegacyCodexMax, removeLegacyStateFile,
  } = require('../src/legacy-max-cleanup');
  const cmd = String(args[args.indexOf('--codex-max') + 1] || 'status').toLowerCase();

  if (cmd === 'on') {
    process.stderr.write(
      'wildcard-perms --codex-max: this feature was removed; nothing was changed.\n'
    );
    process.exitCode = 1;
    return;
  }
  if (args.some((arg) => arg.startsWith('--') && arg !== '--codex-max')) {
    process.stderr.write(
      'wildcard-perms --codex-max: the retired compatibility command accepts no options.\n'
    );
    process.exitCode = 1;
    return;
  }
  if (cmd !== 'status' && cmd !== 'off') {
    process.stderr.write(
      'wildcard-perms --codex-max: retired compatibility command accepts only off or status.\n'
    );
    process.exitCode = 1;
    return;
  }

  let text = '';
  try { text = fs.readFileSync(CODEX_CONFIG, 'utf8'); }
  catch (err) {
    if (err?.code !== 'ENOENT') {
      process.stderr.write(`wildcard-perms --codex-max: read error: ${err.message}\n`);
      process.exitCode = 1;
      return;
    }
  }
  const status = legacyCodexMaxStatus(text);
  if (cmd === 'status') {
    process.stdout.write(
      `wildcard-perms legacy Codex MAX configuration: ${status.present ? 'DETECTED' : 'not active'} ` +
      `(approval_policy=${status.approval ?? 'unset'}, ` +
      `snapshot=${status.snapshotValid ? 'valid' : status.snapshotExists ? 'invalid' : 'absent'})\n`
    );
    return;
  }

  // A bare `approval_policy = "never"` is not proof that this project wrote it.
  // Without a valid old snapshot, leave it byte-for-byte untouched.
  if (status.present && !status.snapshotValid) {
    process.stderr.write(
      'wildcard-perms --codex-max off: refused because approval_policy="never" is present ' +
      'but no valid legacy snapshot proves ownership. config.toml is unchanged.\n'
    );
    process.exitCode = 1;
    return;
  }

  if (!status.present) {
    let removedState = false;
    try { removedState = removeLegacyStateFile(LEGACY_CODEX_STATE_FILE); }
    catch (err) {
      process.stderr.write(
        `wildcard-perms --codex-max off: could not remove the stale legacy snapshot: ${err.message}\n`
      );
      process.exitCode = 1;
      return;
    }
    process.stdout.write(
      'wildcard-perms --codex-max off: no active legacy configuration' +
      `${removedState ? '; removed the stale legacy snapshot' : ''}.\n`
    );
    return;
  }

  const result = removeLegacyCodexMax(text, { confirmAmbiguous: true });
  if (!result.changed) {
    process.stderr.write(
      'wildcard-perms --codex-max off: cleanup could not prove a safe restore; config.toml is unchanged.\n'
    );
    process.exitCode = 1;
    return;
  }

  try {
    // Read again before replacing so a Codex or editor write already visible
    // after the cleanup read is not overwritten by this compatibility path.
    const current = fs.readFileSync(CODEX_CONFIG, 'utf8');
    if (current !== text) {
      process.stderr.write(
        'wildcard-perms --codex-max off: config.toml changed during cleanup; nothing was written.\n'
      );
      process.exitCode = 1;
      return;
    }
    const { writeFileAtomicSync } = require('../src/permissions');
    writeFileAtomicSync(CODEX_CONFIG, result.text);
    const verifiedText = fs.readFileSync(CODEX_CONFIG, 'utf8');
    if (legacyCodexMaxStatus(verifiedText).present) {
      process.stderr.write(
        'wildcard-perms --codex-max off: the legacy setting is still present after the write; ' +
        'the snapshot was retained.\n'
      );
      process.exitCode = 1;
      return;
    }
    removeLegacyStateFile(LEGACY_CODEX_STATE_FILE);
    process.stdout.write(
      'wildcard-perms --codex-max off: removed legacy configuration; ' +
      `approval_policy=${result.restoredTo ?? 'unset (key removed)'}. Restart Codex to apply.\n`
    );
    for (const warning of result.warnings || []) {
      process.stdout.write(`  note: ${warning}\n`);
    }
  } catch (err) {
    process.stderr.write(`wildcard-perms --codex-max off: write error: ${err.message}\n`);
    process.exitCode = 1;
  }
}

// Hidden compatibility handler for the retired Claude MAX flag. It uses the
// normal settings lock and compare-and-swap writer, then verifies the saved file
// before removing artifacts owned by old releases. There is no enable path.
function legacyClaudeMax(args) {
  const {
    legacyClaudeMaxStatus, removeLegacyClaudeMax,
    removeLegacyApproveScript, legacyGeneratedAllowFromState,
  } = require('../src/legacy-max-cleanup');
  const { purgeLegacyBackupCopies } = require('../src/legacy-backup-cleanup');
  const cmd = String(args[args.indexOf('--max') + 1] || 'status').toLowerCase();

  if (cmd === 'on') {
    process.stderr.write('wildcard-perms --max: this feature was removed; nothing was changed.\n');
    process.exitCode = 1;
    return;
  }
  if (cmd !== 'status' && cmd !== 'off') {
    process.stderr.write(
      'wildcard-perms --max: retired compatibility command accepts only off or status.\n'
    );
    process.exitCode = 1;
    return;
  }

  const writer = settingsWriter();
  const initial = writer.readSettingsState();
  if (initial.state === 'unreadable') {
    process.stderr.write(
      `wildcard-perms --max: refused because ${SETTINGS} could not be read or parsed. Nothing was changed.\n`
    );
    process.exitCode = 1;
    return;
  }
  const status = legacyClaudeMaxStatus(initial.settings ?? {});
  if (cmd === 'status') {
    process.stdout.write(
      `wildcard-perms legacy Claude MAX configuration: ${status.present ? 'DETECTED' : 'not active'} ` +
      `(allow-wildcards=${status.allow ? 'present' : 'absent'}, ` +
      `generated-grants=${status.generatedAllow.length}, ` +
      `approve-hook=${status.hook ? 'present' : status.hookLike ? 'ambiguous' : 'absent'}, ` +
      `snapshot=${status.snapshotValid ? 'valid' : status.snapshotExists ? 'invalid' : 'absent'})\n`
    );
    return;
  }

  withPolicyLock('--max', () => {
    let result;
    let wrote = false;
    try {
      ({ result, wrote } = writer.writeTransform((latest) => (
        removeLegacyClaudeMax(latest, { confirmAmbiguous: true })
      )));
    } catch (err) {
      const { SETTINGS_CONTENDED_CODE } = require('../src/settings-write');
      process.stderr.write(err?.code === SETTINGS_CONTENDED_CODE
        ? 'wildcard-perms --max off: settings.json changed during cleanup; nothing was written.\n'
        : `wildcard-perms --max off: refused: ${err.message}\n`);
      process.exitCode = 1;
      return;
    }

    if (result.changed && !wrote) {
      process.stderr.write(
        'wildcard-perms --max off: cleanup was not written; legacy artifacts were retained.\n'
      );
      process.exitCode = 1;
      return;
    }

    // Re-read the bytes written by writeTransform before deleting the only
    // snapshot that can restore them. If no settings change was needed, this
    // same check proves the active configuration was already absent.
    const verifiedState = writer.readSettingsState();
    if (verifiedState.state === 'unreadable') {
      process.stderr.write(
        'wildcard-perms --max off: settings.json could not be verified; legacy artifacts were retained.\n'
      );
      process.exitCode = 1;
      return;
    }
    const verified = legacyClaudeMaxStatus(verifiedState.settings ?? {});
    if (verified.present) {
      process.stderr.write(
        'wildcard-perms --max off: legacy configuration remains after cleanup; ' +
        'the script and snapshot were retained.\n'
      );
      for (const warning of result.warnings || []) {
        process.stderr.write(`  note: ${warning}\n`);
      }
      process.exitCode = 1;
      return;
    }

    const backupResult = purgeLegacyBackupCopies([
      path.join(os.homedir(), '.claude', 'backups', 'allow-list.latest.json'),
      path.join(os.homedir(), '.permission-wildcarding', 'allow-list.latest.json'),
    ], legacyGeneratedAllowFromState());
    if (!backupResult.ok) {
      process.stderr.write(
        'wildcard-perms --max off: settings were cleaned, but every policy backup copy ' +
        'could not be verified; the cleanup snapshot and script were retained.\n'
      );
      for (const failure of backupResult.failures) {
        process.stderr.write(`  ${failure.file}: ${failure.error}\n`);
      }
      process.exitCode = 1;
      return;
    }

    if (!result.canRemoveArtifacts) {
      process.stderr.write(
        'wildcard-perms --max off: cleanup lacks a valid ownership snapshot; artifacts were retained.\n'
      );
      process.exitCode = 1;
      return;
    }

    let scriptResult;
    try { scriptResult = removeLegacyApproveScript(); }
    catch (err) {
      process.stderr.write(
        `wildcard-perms --max off: settings were cleaned, but the legacy script could not be removed: ${err.message}\n`
      );
      process.exitCode = 1;
      return;
    }
    process.stdout.write(
      'wildcard-perms --max off: removed legacy configuration' +
      `${wrote ? ' and updated settings.json' : ''}; ` +
      `approve script ${scriptResult.removed ? 'removed' : scriptResult.reason}; ` +
      'the inert snapshot was retained so an installed extension can filter a configured backup mirror.\n'
    );
    for (const warning of result.warnings || []) {
      process.stdout.write(`  note: ${warning}\n`);
    }
  });
}
