node_modules/
*.wc.tmp
# Patch, merge and backup debris. `src/auto-learn-manager.js` writes uniquely
# named .bak policy backups that nothing prunes, and a conflicted merge leaves
# .orig/.rej behind; none of it should ever be stageable.
*.bak
*.tmp
*.orig
*.rej
# The atomic writers stage through a sibling .tmp before os.replace. The
# finished artefacts are ignored above; their in-flight halves were not, and
# a cancelled write has left one behind before.
*.onnx.tmp
recall_index.json

# build artifacts
*.vsix
# receipt written by scripts/package.mjs, read by scripts/check-version-sync.mjs
.vsix-build.json
# generated by scripts/package.mjs — source of truth is all repo-root src/*.js
vscode-extension/src/
# generated by scripts/package.mjs — source of truth is memory/
vscode-extension/memory/
# local backups from purge/fix helpers
backups/

# memory tool: the 32MB bge-small model is fetched, not committed (vocab is tracked)
memory/models/*.onnx
memory/recall_index.json
__pycache__/

CLAUDE.md
AGENTS.md
# personal per-repo standing orders, and the agent's local settings. A global
# ignore covers the latter on one machine only, which protects nobody else on a
# public repository.
CLAUDE.local.md
.claude/settings.local.json
# Agent scratch state. `.claude/` as a whole is NOT ignored, because a project may
# legitimately want to SHARE .claude/settings.json publicly; these are the subpaths
# no repo should ever carry. The worktrees stub is invisible today only because git
# does not track empty directories, so the first file an agent drops there would be
# stageable on a public repo.
.claude/worktrees/
.claude/agents/
.codex/
.cursorrules
.cursor/
.windsurfrules
.aider*
.continue/
SESSION_*

# Never, on any repo: local environment files.
.env
.env.*
!.env.example

# electron crash log dropped in the repo root
debug.log

# Key material. `.env` was covered from the start and raw key files were not, which is
# the gap a pre-close audit found on 2026-09-25: a stray .pem or id_rsa dropped in this
# tree would have been stageable on a PUBLIC repo. Nothing has ever been tracked under
# these names; this closes the door before it matters rather than after.
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk

# OS and editor debris. Only `debug.log` was ignored, so any other log was stageable.
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
*.log
